{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Git: Quick Commit & Push",
      "type": "shell",
      "command": "git add . && git commit -m \"${input:commitMessage}\" && git push origin main",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ],
  "inputs": [
    {
      "id": "commitMessage",
      "type": "promptString",
      "description": "Mensagem do Commit:",
      "default": "feat: atualiza scripts de automacao"
    }
  ]
}